# Local development only. Native production builds communicate directly with
# the official portal and must not set EXPO_PUBLIC_CGH_PROXY_URL.
APP_VARIANT=development
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CGH_PROXY_URL=http://127.0.0.1:8787
# Optional override. The committed default points to the public GitHub Pages
# update channel.
# EXPO_PUBLIC_OTA_BASE_URL=https://azeez-d3v.github.io/cgh-mobile-downloads/ota
