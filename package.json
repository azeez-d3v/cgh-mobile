{
  "name": "cgh-mobile",
  "version": "1.1.0",
  "description": "Unofficial read-only Android companion for the CGH SchoolAutomate student portal.",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.8",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "lucide-react-native": "^1.27.0",
    "node-html-parser": "^9.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-blob-util": "^0.24.10",
    "react-native-ota-hot-update": "^2.4.4",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.11.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.4",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate": "npm run version:check && npm run typecheck && npm run test:parser && npm run test:errors && npx expo-doctor",
    "test:parser": "tsx scripts/test-portal-parser.ts",
    "test:errors": "tsx scripts/test-user-errors.ts",
    "test:portal": "tsx scripts/test-portal-login.ts",
    "test:portal-login": "tsx scripts/test-portal-login-scenarios.ts",
    "proxy": "tsx scripts/portal-proxy.ts",
    "dev:web": "expo start --web --port 8081",
    "postinstall": "patch-package",
    "prebuild:android": "expo prebuild --platform android --clean",
    "bundle:android": "expo export:embed --platform android --dev false --entry-file index.ts --bundle-output .ota/package/index.android.bundle --assets-dest .ota/package",
    "test:ota": "node scripts/verify-ota-package.mjs",
    "version:set": "node scripts/set-app-version.mjs",
    "version:check": "node scripts/set-app-version.mjs --check"
  },
  "private": true,
  "license": "MIT",
  "author": "Aziz Saricula",
  "repository": {
    "type": "git",
    "url": "https://github.com/azeez-d3v/cgh-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/azeez-d3v/cgh-mobile/issues"
  },
  "homepage": "https://github.com/azeez-d3v/cgh-mobile#readme",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
