{
  "name": "cgh-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.10",
    "lucide-react-native": "^1.27.0",
    "node-html-parser": "^9.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.4",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test:parser && npx expo-doctor",
    "test:parser": "tsx scripts/test-portal-parser.ts",
    "test:portal": "tsx scripts/test-portal-login.ts",
    "proxy": "tsx scripts/portal-proxy.ts",
    "dev:web": "expo start --web --port 8081",
    "build:development": "npx eas-cli@latest build --platform android --profile development",
    "build:production": "npx eas-cli@latest build --platform android --profile production",
    "update:development": "npx eas-cli@latest update --channel development --environment development",
    "update:production": "npx eas-cli@latest update --channel production --environment production"
  },
  "private": true
}
