{
  "expo": {
    "name": "Portal",
    "slug": "cgh-mobile",
    "version": "1.1.0",
    "scheme": "cghmobile",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.azeezd3v.cghmobile",
      "versionCode": 1001000,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FDE7EF",
        "foregroundImage": "./assets/portal-splash-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon-v2.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7FA",
          "image": "./assets/portal-splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "android": {
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "react-native-ota-hot-update",
      "./plugins/withAndroidDnsFallback",
      "./plugins/withAndroidReleaseHardening",
      "./plugins/withAndroidReleaseSigning"
    ]
  }
}
